# Copia este archivo a `.env` y ajusta los valores. `.env` nunca se sube al repo.
ENVIRONMENT=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=hestia_db

# Obligatoria, mínimo 32 caracteres. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Opcional: datos del primer administrador para `python seed_roles.py`
# (si no se definen, el script los pide por consola).
ADMIN_NOMBRE=juan
ADMIN_EMAIL=juan@gmail.com
ADMIN_PASSWORD=1234juan