ENVIRONMENT=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=TU_PASSWORD
DB_NAME=TU_DB


SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60


ADMIN_NOMBRE=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Pagos en línea con Wompi (opcional). Déjalos vacíos para no cobrar en línea.
# Ver README, sección "Pagos en línea con Wompi". Estos valores son secretos: nunca los subas al repositorio.
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# Dirección pública del frontend, a la que Wompi devuelve al huésped después de pagar.
FRONTEND_URL=http://localhost:5173

# --- Despliegue en la nube (ver DESPLIEGUE.md) ---
# MySQL en la nube exige conexión cifrada. DB_SSL_CA_PEM = contenido del ca.pem del proveedor
# (si lo pegas en una sola línea, escribe los saltos de línea como \n).
DB_SSL=false
DB_SSL_CA=
DB_SSL_CA_PEM=
